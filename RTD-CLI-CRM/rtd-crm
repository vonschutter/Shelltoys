#!/usr/bin/env bash

set -o pipefail

APP_NAME="rtd-crm"
VERSION="0.1.0"

CRM_DIR="${RTD_CRM_DIR:-${XDG_DATA_HOME:-${HOME}/.local/share}/rtd-crm}"
CUSTOMERS_DIR=""
OPPORTUNITIES_DIR=""

COLOR_YELLOW=$'\033[1;33m'
COLOR_GREEN=$'\033[1;32m'
COLOR_RED=$'\033[1;31m'
COLOR_BLUE=$'\033[1;34m'
COLOR_RESET=$'\033[0m'

usage() {
	cat <<EOF
${COLOR_GREEN}${APP_NAME}${COLOR_RESET} - text-file CRM for customers, opportunities, and communication logs.

Usage:
  ${APP_NAME} [--dir PATH] <command> [arguments]

Global options:
  --dir PATH              Use a custom CRM data directory.
  --help, -h              Show this help text.
  --version               Show version.

Customer commands:
  customer add --name NAME [--company TEXT] [--email EMAIL] [--phone PHONE] [--address TEXT] [--notes TEXT] [--id ID] [--edit]
  customer list [--sort id|name|company|created|updated] [--reverse]
  customer show CUSTOMER
  customer edit CUSTOMER
  customer log CUSTOMER --type TYPE --summary TEXT [--detail TEXT]

Opportunity commands:
  opportunity add --customer CUSTOMER --title TITLE [--value AMOUNT] [--stage STAGE] [--probability N] [--close-date DATE] [--detail TEXT] [--id ID] [--edit]
  opportunity list [--sort id|title|customer|stage|value|probability|close-date|created|updated] [--stage STAGE] [--reverse]
  opportunity show OPPORTUNITY
  opportunity edit OPPORTUNITY
  opportunity stage OPPORTUNITY STAGE
  opportunity log OPPORTUNITY --type TYPE --summary TEXT [--detail TEXT]

Log commands:
  log add --customer CUSTOMER [--opportunity OPPORTUNITY] --type TYPE --summary TEXT [--detail TEXT]

Utility commands:
  ui                      Open the dialog-based text UI.
  init                    Create the CRM data directories.
  path                    Print the CRM data directory.

Storage:
  Customers:     ${CRM_DIR}/customers/<customer-id>.customer
  Opportunities: ${CRM_DIR}/opportunities/<opportunity-id>.opportunity

Examples:
  ${APP_NAME} customer add --name "Acme AB" --email sales@example.com --phone "+46 8 123 456"
  ${APP_NAME} opportunity add --customer acme-ab --title "Support agreement" --value 25000 --stage proposal
  ${APP_NAME} opportunity list --sort value --reverse
  ${APP_NAME} ui
  ${APP_NAME} customer log acme-ab --type call --summary "Discussed renewal"
  EDITOR=vim ${APP_NAME} opportunity edit support-agreement
EOF
}

die() {
	printf "%b\n" "${COLOR_RED}Error:${COLOR_RESET} $*" >&2
	exit 1
}

warn() {
	printf "%b\n" "${COLOR_YELLOW}$*${COLOR_RESET}" >&2
}

status() {
	printf "%b\n" "${COLOR_GREEN}$*${COLOR_RESET}"
}

configure_paths() {
	CUSTOMERS_DIR="${CRM_DIR}/customers"
	OPPORTUNITIES_DIR="${CRM_DIR}/opportunities"
}

ensure_dirs() {
	configure_paths
	mkdir -p "${CUSTOMERS_DIR}" "${OPPORTUNITIES_DIR}" || die "Unable to create CRM data directories in ${CRM_DIR}"
}

timestamp() {
	date '+%Y-%m-%d %H:%M:%S'
}

today() {
	date '+%Y-%m-%d'
}

sanitize_value() {
	printf '%s' "${1:-}" | tr '\t\r\n' '   ' | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//'
}

slugify() {
	local input="${1:-}"
	local slug

	slug=$(printf '%s' "$input" \
		| tr '[:upper:]' '[:lower:]' \
		| sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//; s/-+/-/g')

	if [[ -z "$slug" ]]; then
		slug="record-$(date '+%Y%m%d%H%M%S')"
	fi

	printf '%s\n' "$slug"
}

unique_id() {
	local dir="$1"
	local ext="$2"
	local requested="$3"
	local base
	local candidate
	local counter=2

	base=$(slugify "$requested")
	candidate="$base"

	while [[ -e "${dir}/${candidate}.${ext}" ]]; do
		candidate="${base}-${counter}"
		counter=$((counter + 1))
	done

	printf '%s\n' "$candidate"
}

field() {
	local file="$1"
	local key="$2"

	awk -v wanted="$key" '
		BEGIN { wanted = tolower(wanted) }
		/^## / { exit }
		{
			pos = index($0, ":")
			if (pos == 0) {
				next
			}
			key = tolower(substr($0, 1, pos - 1))
			if (key == wanted) {
				value = substr($0, pos + 1)
				sub(/^ /, "", value)
				print value
				exit
			}
		}
	' "$file"
}

set_field() {
	local file="$1"
	local key="$2"
	local value
	local tmp

	value=$(sanitize_value "${3:-}")
	tmp=$(mktemp "${file}.XXXXXX") || return 1

	awk -v wanted="$key" -v replacement="${key}: ${value}" '
		BEGIN {
			wanted = tolower(wanted)
			replaced = 0
			in_meta = 1
		}
		/^## / {
			if (!replaced) {
				print replacement
				replaced = 1
			}
			in_meta = 0
			print
			next
		}
		in_meta {
			pos = index($0, ":")
			if (pos > 0 && tolower(substr($0, 1, pos - 1)) == wanted) {
				print replacement
				replaced = 1
				next
			}
		}
		{ print }
		END {
			if (!replaced) {
				print replacement
			}
		}
	' "$file" >"$tmp" && mv "$tmp" "$file"
}

touch_updated() {
	set_field "$1" "updated_at" "$(timestamp)"
}

customer_file() {
	local customer="${1:-}"
	local direct
	local match=""
	local count=0
	local file
	local name

	[[ -n "$customer" ]] || die "Customer id or name is required."

	direct="${CUSTOMERS_DIR}/$(slugify "$customer").customer"
	if [[ -f "$direct" ]]; then
		printf '%s\n' "$direct"
		return 0
	fi

	for file in "${CUSTOMERS_DIR}"/*.customer; do
		[[ -e "$file" ]] || break
		name=$(field "$file" "name")
		if [[ "${name,,}" == "${customer,,}" ]]; then
			match="$file"
			count=$((count + 1))
		fi
	done

	if [[ "$count" -eq 1 ]]; then
		printf '%s\n' "$match"
		return 0
	fi

	if [[ "$count" -gt 1 ]]; then
		die "Customer name is ambiguous: ${customer}. Use the customer id."
	fi

	die "Customer not found: ${customer}"
}

opportunity_file() {
	local opportunity="${1:-}"
	local direct
	local match=""
	local count=0
	local file
	local title

	[[ -n "$opportunity" ]] || die "Opportunity id or title is required."

	direct="${OPPORTUNITIES_DIR}/$(slugify "$opportunity").opportunity"
	if [[ -f "$direct" ]]; then
		printf '%s\n' "$direct"
		return 0
	fi

	for file in "${OPPORTUNITIES_DIR}"/*.opportunity; do
		[[ -e "$file" ]] || break
		title=$(field "$file" "title")
		if [[ "${title,,}" == "${opportunity,,}" ]]; then
			match="$file"
			count=$((count + 1))
		fi
	done

	if [[ "$count" -eq 1 ]]; then
		printf '%s\n' "$match"
		return 0
	fi

	if [[ "$count" -gt 1 ]]; then
		die "Opportunity title is ambiguous: ${opportunity}. Use the opportunity id."
	fi

	die "Opportunity not found: ${opportunity}"
}

customer_name_by_id() {
	local id="$1"
	local file="${CUSTOMERS_DIR}/${id}.customer"

	if [[ -f "$file" ]]; then
		field "$file" "name"
	else
		printf '%s\n' "$id"
	fi
}

editor_command() {
	if [[ -n "${EDITOR:-}" ]]; then
		printf '%s\n' "$EDITOR"
	elif command -v nano >/dev/null 2>&1; then
		printf '%s\n' "nano"
	else
		printf '%s\n' "vi"
	fi
}

edit_file() {
	local file="$1"
	local editor

	editor=$(editor_command)
	$editor "$file" || return 1
	touch_updated "$file"
}

append_log() {
	local file="$1"
	local type="$2"
	local summary="$3"
	local detail="${4:-}"

	type=$(sanitize_value "$type")
	summary=$(sanitize_value "$summary")

	[[ -n "$type" ]] || die "Log type is required."
	[[ -n "$summary" ]] || die "Log summary is required."

	if ! grep -q '^## Communication Log$' "$file"; then
		printf '\n## Communication Log\n' >>"$file"
	fi

	{
		printf '\n### %s [%s] %s\n' "$(timestamp)" "$type" "$summary"
		if [[ -n "$detail" ]]; then
			printf '%s\n' "$detail" | sed 's/^/    /'
		fi
	} >>"$file"

	touch_updated "$file"
}

require_value() {
	local option="$1"
	local value="${2:-}"

	[[ -n "$value" ]] || die "Missing value for ${option}"
}

command_init() {
	ensure_dirs
	status "CRM data directory is ready: ${CRM_DIR}"
}

command_path() {
	configure_paths
	printf '%s\n' "$CRM_DIR"
}

customer_add() {
	local id=""
	local name=""
	local company=""
	local email=""
	local phone=""
	local address=""
	local notes=""
	local edit_after=0
	local file
	local now

	while [[ $# -gt 0 ]]; do
		case "$1" in
			--id) require_value "$1" "${2:-}"; id="$2"; shift 2 ;;
			--name) require_value "$1" "${2:-}"; name="$2"; shift 2 ;;
			--company) require_value "$1" "${2:-}"; company="$2"; shift 2 ;;
			--email) require_value "$1" "${2:-}"; email="$2"; shift 2 ;;
			--phone) require_value "$1" "${2:-}"; phone="$2"; shift 2 ;;
			--address) require_value "$1" "${2:-}"; address="$2"; shift 2 ;;
			--notes) require_value "$1" "${2:-}"; notes="$2"; shift 2 ;;
			--edit) edit_after=1; shift ;;
			*) die "Unknown customer add option: $1" ;;
		esac
	done

	[[ -n "$name" ]] || die "customer add requires --name"
	ensure_dirs

	id=$(unique_id "$CUSTOMERS_DIR" "customer" "${id:-$name}")
	file="${CUSTOMERS_DIR}/${id}.customer"
	now=$(timestamp)

	{
		printf 'id: %s\n' "$id"
		printf 'name: %s\n' "$(sanitize_value "$name")"
		printf 'company: %s\n' "$(sanitize_value "$company")"
		printf 'email: %s\n' "$(sanitize_value "$email")"
		printf 'phone: %s\n' "$(sanitize_value "$phone")"
		printf 'address: %s\n' "$(sanitize_value "$address")"
		printf 'created_at: %s\n' "$now"
		printf 'updated_at: %s\n' "$now"
		printf '\n## Notes\n'
		[[ -n "$notes" ]] && printf '%s\n' "$notes"
		printf '\n## Communication Log\n'
	} >"$file" || die "Unable to write customer file: $file"

	status "Created customer: ${id}"

	if [[ "$edit_after" -eq 1 ]]; then
		edit_file "$file"
	fi
}

customer_list() {
	local sort_by="name"
	local reverse=0
	local file
	local sort_value
	local sort_flag=""

	while [[ $# -gt 0 ]]; do
		case "$1" in
			--sort) require_value "$1" "${2:-}"; sort_by="$2"; shift 2 ;;
			--reverse) reverse=1; shift ;;
			*) die "Unknown customer list option: $1" ;;
		esac
	done

	ensure_dirs

	[[ "$reverse" -eq 1 ]] && sort_flag="-r"

	{
		for file in "${CUSTOMERS_DIR}"/*.customer; do
			[[ -e "$file" ]] || break
			case "$sort_by" in
				id) sort_value=$(field "$file" "id") ;;
				name) sort_value=$(field "$file" "name") ;;
				company) sort_value=$(field "$file" "company") ;;
				created) sort_value=$(field "$file" "created_at") ;;
				updated) sort_value=$(field "$file" "updated_at") ;;
				*) die "Unsupported customer sort field: $sort_by" ;;
			esac
			printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
				"$sort_value" \
				"$(field "$file" "id")" \
				"$(field "$file" "name")" \
				"$(field "$file" "company")" \
				"$(field "$file" "email")" \
				"$(field "$file" "phone")"
		done
	} | sort $sort_flag -t "$(printf '\t')" -k1,1 | awk -F '\t' '
		BEGIN {
			printf "%-24s %-28s %-24s %-30s %-18s\n", "ID", "NAME", "COMPANY", "EMAIL", "PHONE"
			printf "%-24s %-28s %-24s %-30s %-18s\n", "--", "----", "-------", "-----", "-----"
		}
		{
			printf "%-24s %-28s %-24s %-30s %-18s\n", $2, $3, $4, $5, $6
		}
	'
}

customer_show() {
	ensure_dirs
	cat "$(customer_file "${1:-}")"
}

customer_edit() {
	ensure_dirs
	edit_file "$(customer_file "${1:-}")"
}

customer_log() {
	local customer="${1:-}"
	local type=""
	local summary=""
	local detail=""
	local file

	[[ -n "$customer" ]] || die "customer log requires CUSTOMER"
	shift || true

	while [[ $# -gt 0 ]]; do
		case "$1" in
			--type) require_value "$1" "${2:-}"; type="$2"; shift 2 ;;
			--summary) require_value "$1" "${2:-}"; summary="$2"; shift 2 ;;
			--detail) require_value "$1" "${2:-}"; detail="$2"; shift 2 ;;
			*) die "Unknown customer log option: $1" ;;
		esac
	done

	ensure_dirs
	file=$(customer_file "$customer")
	append_log "$file" "$type" "$summary" "$detail"
	status "Added customer log entry: $(field "$file" "id")"
}

opportunity_add() {
	local id=""
	local customer=""
	local customer_id=""
	local title=""
	local value="0"
	local stage="lead"
	local probability="0"
	local close_date=""
	local detail=""
	local edit_after=0
	local customer_file_path
	local file
	local now

	while [[ $# -gt 0 ]]; do
		case "$1" in
			--id) require_value "$1" "${2:-}"; id="$2"; shift 2 ;;
			--customer) require_value "$1" "${2:-}"; customer="$2"; shift 2 ;;
			--title) require_value "$1" "${2:-}"; title="$2"; shift 2 ;;
			--value) require_value "$1" "${2:-}"; value="$2"; shift 2 ;;
			--stage) require_value "$1" "${2:-}"; stage="$2"; shift 2 ;;
			--probability) require_value "$1" "${2:-}"; probability="$2"; shift 2 ;;
			--close-date) require_value "$1" "${2:-}"; close_date="$2"; shift 2 ;;
			--detail) require_value "$1" "${2:-}"; detail="$2"; shift 2 ;;
			--edit) edit_after=1; shift ;;
			*) die "Unknown opportunity add option: $1" ;;
		esac
	done

	[[ -n "$customer" ]] || die "opportunity add requires --customer"
	[[ -n "$title" ]] || die "opportunity add requires --title"
	ensure_dirs

	customer_file_path=$(customer_file "$customer")
	customer_id=$(field "$customer_file_path" "id")
	id=$(unique_id "$OPPORTUNITIES_DIR" "opportunity" "${id:-$title}")
	file="${OPPORTUNITIES_DIR}/${id}.opportunity"
	now=$(timestamp)

	{
		printf 'id: %s\n' "$id"
		printf 'customer_id: %s\n' "$customer_id"
		printf 'title: %s\n' "$(sanitize_value "$title")"
		printf 'value: %s\n' "$(sanitize_value "$value")"
		printf 'stage: %s\n' "$(sanitize_value "$stage")"
		printf 'probability: %s\n' "$(sanitize_value "$probability")"
		printf 'close_date: %s\n' "$(sanitize_value "${close_date:-$(today)}")"
		printf 'created_at: %s\n' "$now"
		printf 'updated_at: %s\n' "$now"
		printf '\n## Detail\n'
		[[ -n "$detail" ]] && printf '%s\n' "$detail"
		printf '\n## Communication Log\n'
	} >"$file" || die "Unable to write opportunity file: $file"

	status "Created opportunity: ${id}"

	if [[ "$edit_after" -eq 1 ]]; then
		edit_file "$file"
	fi
}

opportunity_list() {
	local sort_by="updated"
	local reverse=0
	local stage_filter=""
	local file
	local sort_value
	local sort_flag=""
	local numeric_sort=0
	local customer_id
	local stage

	while [[ $# -gt 0 ]]; do
		case "$1" in
			--sort) require_value "$1" "${2:-}"; sort_by="$2"; shift 2 ;;
			--stage) require_value "$1" "${2:-}"; stage_filter="$2"; shift 2 ;;
			--reverse) reverse=1; shift ;;
			*) die "Unknown opportunity list option: $1" ;;
		esac
	done

	ensure_dirs

	[[ "$reverse" -eq 1 ]] && sort_flag="-r"

	case "$sort_by" in
		value | probability) numeric_sort=1 ;;
	esac

	{
		for file in "${OPPORTUNITIES_DIR}"/*.opportunity; do
			[[ -e "$file" ]] || break
			stage=$(field "$file" "stage")
			if [[ -n "$stage_filter" && "${stage,,}" != "${stage_filter,,}" ]]; then
				continue
			fi

			customer_id=$(field "$file" "customer_id")
			case "$sort_by" in
				id) sort_value=$(field "$file" "id") ;;
				title) sort_value=$(field "$file" "title") ;;
				customer) sort_value=$(customer_name_by_id "$customer_id") ;;
				stage) sort_value="$stage" ;;
				value) sort_value=$(field "$file" "value" | sed -E 's/[^0-9.-]//g') ;;
				probability) sort_value=$(field "$file" "probability" | sed -E 's/[^0-9.-]//g') ;;
				close-date) sort_value=$(field "$file" "close_date") ;;
				created) sort_value=$(field "$file" "created_at") ;;
				updated) sort_value=$(field "$file" "updated_at") ;;
				*) die "Unsupported opportunity sort field: $sort_by" ;;
			esac

			printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
				"${sort_value:-0}" \
				"$(field "$file" "id")" \
				"$(field "$file" "title")" \
				"$(customer_name_by_id "$customer_id")" \
				"$stage" \
				"$(field "$file" "value")" \
				"$(field "$file" "probability")" \
				"$(field "$file" "close_date")"
		done
	} | if [[ "$numeric_sort" -eq 1 ]]; then
		sort $sort_flag -n -t "$(printf '\t')" -k1,1
	else
		sort $sort_flag -t "$(printf '\t')" -k1,1
	fi | awk -F '\t' '
		BEGIN {
			printf "%-24s %-30s %-26s %-14s %12s %6s %-12s\n", "ID", "TITLE", "CUSTOMER", "STAGE", "VALUE", "PROB", "CLOSE_DATE"
			printf "%-24s %-30s %-26s %-14s %12s %6s %-12s\n", "--", "-----", "--------", "-----", "-----", "----", "----------"
		}
		{
			printf "%-24s %-30s %-26s %-14s %12s %6s %-12s\n", $2, $3, $4, $5, $6, $7, $8
		}
	'
}

opportunity_show() {
	ensure_dirs
	cat "$(opportunity_file "${1:-}")"
}

opportunity_edit() {
	ensure_dirs
	edit_file "$(opportunity_file "${1:-}")"
}

opportunity_stage() {
	local opportunity="${1:-}"
	local stage="${2:-}"
	local file

	[[ -n "$opportunity" ]] || die "opportunity stage requires OPPORTUNITY"
	[[ -n "$stage" ]] || die "opportunity stage requires STAGE"
	ensure_dirs

	file=$(opportunity_file "$opportunity")
	set_field "$file" "stage" "$stage"
	touch_updated "$file"
	status "Updated opportunity stage: $(field "$file" "id") -> $(field "$file" "stage")"
}

opportunity_log() {
	local opportunity="${1:-}"
	local type=""
	local summary=""
	local detail=""
	local file

	[[ -n "$opportunity" ]] || die "opportunity log requires OPPORTUNITY"
	shift || true

	while [[ $# -gt 0 ]]; do
		case "$1" in
			--type) require_value "$1" "${2:-}"; type="$2"; shift 2 ;;
			--summary) require_value "$1" "${2:-}"; summary="$2"; shift 2 ;;
			--detail) require_value "$1" "${2:-}"; detail="$2"; shift 2 ;;
			*) die "Unknown opportunity log option: $1" ;;
		esac
	done

	ensure_dirs
	file=$(opportunity_file "$opportunity")
	append_log "$file" "$type" "$summary" "$detail"
	status "Added opportunity log entry: $(field "$file" "id")"
}

log_add() {
	local customer=""
	local opportunity=""
	local type=""
	local summary=""
	local detail=""
	local customer_path=""
	local opportunity_path=""

	while [[ $# -gt 0 ]]; do
		case "$1" in
			--customer) require_value "$1" "${2:-}"; customer="$2"; shift 2 ;;
			--opportunity) require_value "$1" "${2:-}"; opportunity="$2"; shift 2 ;;
			--type) require_value "$1" "${2:-}"; type="$2"; shift 2 ;;
			--summary) require_value "$1" "${2:-}"; summary="$2"; shift 2 ;;
			--detail) require_value "$1" "${2:-}"; detail="$2"; shift 2 ;;
			*) die "Unknown log add option: $1" ;;
		esac
	done

	[[ -n "$customer" ]] || die "log add requires --customer"
	ensure_dirs

	customer_path=$(customer_file "$customer")
	append_log "$customer_path" "$type" "$summary" "$detail"

	if [[ -n "$opportunity" ]]; then
		opportunity_path=$(opportunity_file "$opportunity")
		append_log "$opportunity_path" "$type" "$summary" "$detail"
	fi

	status "Added communication log entry."
}

customer_command() {
	local subcommand="${1:-}"
	shift || true

	case "$subcommand" in
		add) customer_add "$@" ;;
		list) customer_list "$@" ;;
		show) customer_show "$@" ;;
		edit) customer_edit "$@" ;;
		log) customer_log "$@" ;;
		--help | -h | "") usage ;;
		*) die "Unknown customer command: $subcommand" ;;
	esac
}

opportunity_command() {
	local subcommand="${1:-}"
	shift || true

	case "$subcommand" in
		add) opportunity_add "$@" ;;
		list) opportunity_list "$@" ;;
		show) opportunity_show "$@" ;;
		edit) opportunity_edit "$@" ;;
		stage) opportunity_stage "$@" ;;
		log) opportunity_log "$@" ;;
		--help | -h | "") usage ;;
		*) die "Unknown opportunity command: $subcommand" ;;
	esac
}

log_command() {
	local subcommand="${1:-}"
	shift || true

	case "$subcommand" in
		add) log_add "$@" ;;
		--help | -h | "") usage ;;
		*) die "Unknown log command: $subcommand" ;;
	esac
}

ui_require_dialog() {
	if ! command -v dialog >/dev/null 2>&1; then
		die "The dialog command is required for the UI. Install the 'dialog' package or use the CLI commands."
	fi
}

ui_msg() {
	dialog --title "${APP_NAME}" --msgbox "$1" 10 70
}

ui_error() {
	dialog --title "${APP_NAME}" --msgbox "Error: $1" 10 70
}

ui_textbox() {
	local title="$1"
	local file="$2"

	dialog --title "$title" --textbox "$file" 30 100
}

ui_edit_file() {
	local title="$1"
	local file="$2"
	local tmp

	tmp=$(mktemp "${file}.ui.XXXXXX") || {
		ui_error "Unable to create temporary edit file."
		return 1
	}

	if dialog --stdout --title "$title" --editbox "$file" 30 100 >"$tmp"; then
		mv "$tmp" "$file" || {
			rm -f "$tmp"
			ui_error "Unable to save edited file."
			return 1
		}
		touch_updated "$file"
		ui_msg "Saved."
	else
		rm -f "$tmp"
	fi
}

ui_input() {
	local title="$1"
	local prompt="$2"
	local initial="${3:-}"

	dialog --stdout --title "$title" --inputbox "$prompt" 10 70 "$initial"
}

ui_text_input() {
	local title="$1"
	local prompt="$2"
	local initial="${3:-}"
	local input_file
	local output

	input_file=$(mktemp) || return 1
	printf '%s\n' "$initial" >"$input_file"
	output=$(dialog --stdout --title "$title" --editbox "$input_file" 18 80)
	local rc=$?
	rm -f "$input_file"
	[[ "$rc" -eq 0 ]] || return "$rc"
	printf '%s\n' "$output"
}

ui_select_customer() {
	local title="${1:-Select customer}"
	local items=()
	local file
	local id
	local name
	local company

	ensure_dirs
	for file in "${CUSTOMERS_DIR}"/*.customer; do
		[[ -e "$file" ]] || break
		id=$(field "$file" "id")
		name=$(field "$file" "name")
		company=$(field "$file" "company")
		items+=("$id" "${name}${company:+ (${company})}")
	done

	if [[ "${#items[@]}" -eq 0 ]]; then
		ui_error "No customers exist yet."
		return 1
	fi

	dialog --stdout --title "$title" --menu "Choose a customer:" 22 90 14 "${items[@]}"
}

ui_select_opportunity() {
	local title="${1:-Select opportunity}"
	local stage_filter="${2:-}"
	local items=()
	local file
	local id
	local title_text
	local customer_id
	local customer_name
	local stage
	local value

	ensure_dirs
	for file in "${OPPORTUNITIES_DIR}"/*.opportunity; do
		[[ -e "$file" ]] || break
		stage=$(field "$file" "stage")
		if [[ -n "$stage_filter" && "${stage,,}" != "${stage_filter,,}" ]]; then
			continue
		fi
		id=$(field "$file" "id")
		title_text=$(field "$file" "title")
		customer_id=$(field "$file" "customer_id")
		customer_name=$(customer_name_by_id "$customer_id")
		value=$(field "$file" "value")
		items+=("$id" "${title_text} | ${customer_name} | ${stage} | ${value}")
	done

	if [[ "${#items[@]}" -eq 0 ]]; then
		ui_error "No opportunities match this view."
		return 1
	fi

	dialog --stdout --title "$title" --menu "Choose an opportunity:" 24 110 16 "${items[@]}"
}

ui_add_customer() {
	local output
	local fields=()
	local name
	local company
	local email
	local phone
	local address
	local notes

	output=$(dialog --stdout --title "Add Customer" --form "Create a customer record" 18 80 8 \
		"Name:" 1 1 "" 1 18 50 200 \
		"Company:" 2 1 "" 2 18 50 200 \
		"Email:" 3 1 "" 3 18 50 200 \
		"Phone:" 4 1 "" 4 18 50 200 \
		"Address:" 5 1 "" 5 18 50 200) || return 0

	mapfile -t fields <<<"$output"
	name="${fields[0]:-}"
	company="${fields[1]:-}"
	email="${fields[2]:-}"
	phone="${fields[3]:-}"
	address="${fields[4]:-}"

	if [[ -z "$name" ]]; then
		ui_error "Name is required."
		return 1
	fi

	notes=$(ui_text_input "Customer Notes" "Optional notes:" "") || notes=""
	customer_add --name "$name" --company "$company" --email "$email" --phone "$phone" --address "$address" --notes "$notes" >/dev/null
	ui_msg "Created customer: $(slugify "$name")"
}

ui_manage_customer() {
	local customer_id
	local action
	local file

	customer_id=$(ui_select_customer "Customers") || return 0
	file=$(customer_file "$customer_id")

	while true; do
		action=$(dialog --stdout --title "Customer: ${customer_id}" --menu "Choose an action:" 18 70 8 \
			view "View customer file" \
			edit "Edit customer file" \
			log "Add communication log" \
			opportunity "Add opportunity for this customer" \
			back "Back") || return 0

		case "$action" in
			view) ui_textbox "Customer: ${customer_id}" "$file" ;;
			edit) ui_edit_file "Edit Customer: ${customer_id}" "$file" ;;
			log) ui_customer_log "$customer_id" ;;
			opportunity) ui_add_opportunity "$customer_id" ;;
			back) return 0 ;;
		esac
	done
}

ui_customer_log() {
	local customer_id="$1"
	local type
	local summary
	local detail

	type=$(ui_input "Customer Log" "Communication type:" "call") || return 0
	summary=$(ui_input "Customer Log" "Summary:" "") || return 0
	detail=$(ui_text_input "Customer Log Detail" "Optional detail:" "") || detail=""

	if [[ -z "$type" || -z "$summary" ]]; then
		ui_error "Type and summary are required."
		return 1
	fi

	customer_log "$customer_id" --type "$type" --summary "$summary" --detail "$detail" >/dev/null
	ui_msg "Added log entry."
}

ui_customer_menu() {
	local choice

	while true; do
		choice=$(dialog --stdout --title "Customers" --menu "Customer actions:" 18 70 8 \
			add "Add customer" \
			manage "View, edit, or log customer" \
			list "Show customer list" \
			back "Back") || return 0

		case "$choice" in
			add) ui_add_customer ;;
			manage) ui_manage_customer ;;
			list)
				local tmp
				tmp=$(mktemp)
				customer_list >"$tmp"
				ui_textbox "Customers" "$tmp"
				rm -f "$tmp"
				;;
			back) return 0 ;;
		esac
	done
}

ui_add_opportunity() {
	local customer_id="${1:-}"
	local output
	local fields=()
	local title
	local value
	local stage
	local probability
	local close_date
	local detail

	if [[ -z "$customer_id" ]]; then
		customer_id=$(ui_select_customer "Opportunity Customer") || return 0
	fi

	output=$(dialog --stdout --title "Add Opportunity" --form "Create an opportunity for ${customer_id}" 18 90 8 \
		"Title:" 1 1 "" 1 20 55 200 \
		"Value:" 2 1 "0" 2 20 20 40 \
		"Stage:" 3 1 "lead" 3 20 24 80 \
		"Probability:" 4 1 "0" 4 20 10 10 \
		"Close date:" 5 1 "$(today)" 5 20 14 20) || return 0

	mapfile -t fields <<<"$output"
	title="${fields[0]:-}"
	value="${fields[1]:-0}"
	stage="${fields[2]:-lead}"
	probability="${fields[3]:-0}"
	close_date="${fields[4]:-$(today)}"

	if [[ -z "$title" ]]; then
		ui_error "Title is required."
		return 1
	fi

	detail=$(ui_text_input "Opportunity Detail" "Optional detail:" "") || detail=""
	opportunity_add --customer "$customer_id" --title "$title" --value "$value" --stage "$stage" --probability "$probability" --close-date "$close_date" --detail "$detail" >/dev/null
	ui_msg "Created opportunity: $(slugify "$title")"
}

ui_manage_opportunity() {
	local opportunity_id
	local action
	local file

	opportunity_id=$(ui_select_opportunity "Opportunities") || return 0
	file=$(opportunity_file "$opportunity_id")

	while true; do
		action=$(dialog --stdout --title "Opportunity: ${opportunity_id}" --menu "Choose an action:" 18 70 8 \
			view "View opportunity file" \
			edit "Edit opportunity file" \
			stage "Change stage" \
			log "Add communication log" \
			back "Back") || return 0

		case "$action" in
			view) ui_textbox "Opportunity: ${opportunity_id}" "$file" ;;
			edit) ui_edit_file "Edit Opportunity: ${opportunity_id}" "$file" ;;
			stage) ui_change_opportunity_stage "$opportunity_id" ;;
			log) ui_opportunity_log "$opportunity_id" ;;
			back) return 0 ;;
		esac
	done
}

ui_change_opportunity_stage() {
	local opportunity_id="$1"
	local current
	local new_stage
	local file

	file=$(opportunity_file "$opportunity_id")
	current=$(field "$file" "stage")
	new_stage=$(dialog --stdout --title "Change Stage" --menu "Current stage: ${current}" 18 70 8 \
		lead "Initial lead" \
		qualified "Qualified opportunity" \
		proposal "Proposal sent" \
		negotiation "Negotiation" \
		won "Won" \
		lost "Lost" \
		custom "Enter custom stage") || return 0

	if [[ "$new_stage" == "custom" ]]; then
		new_stage=$(ui_input "Custom Stage" "Stage:" "$current") || return 0
	fi

	[[ -n "$new_stage" ]] || return 0
	opportunity_stage "$opportunity_id" "$new_stage" >/dev/null
	ui_msg "Stage updated to: ${new_stage}"
}

ui_opportunity_log() {
	local opportunity_id="$1"
	local type
	local summary
	local detail

	type=$(ui_input "Opportunity Log" "Communication type:" "email") || return 0
	summary=$(ui_input "Opportunity Log" "Summary:" "") || return 0
	detail=$(ui_text_input "Opportunity Log Detail" "Optional detail:" "") || detail=""

	if [[ -z "$type" || -z "$summary" ]]; then
		ui_error "Type and summary are required."
		return 1
	fi

	opportunity_log "$opportunity_id" --type "$type" --summary "$summary" --detail "$detail" >/dev/null
	ui_msg "Added log entry."
}

ui_opportunity_list() {
	local sort_by
	local reverse
	local tmp

	sort_by=$(dialog --stdout --title "Opportunity List" --menu "Sort opportunities by:" 18 70 10 \
		updated "Last updated" \
		value "Value" \
		stage "Stage" \
		customer "Customer" \
		close-date "Close date" \
		probability "Probability" \
		title "Title") || return 0

	reverse=$(dialog --stdout --title "Opportunity List" --menu "Sort direction:" 12 60 4 \
		normal "Ascending / oldest first" \
		reverse "Descending / newest first") || return 0

	tmp=$(mktemp)
	if [[ "$reverse" == "reverse" ]]; then
		opportunity_list --sort "$sort_by" --reverse >"$tmp"
	else
		opportunity_list --sort "$sort_by" >"$tmp"
	fi
	ui_textbox "Opportunities sorted by ${sort_by}" "$tmp"
	rm -f "$tmp"
}

ui_opportunity_menu() {
	local choice

	while true; do
		choice=$(dialog --stdout --title "Opportunities" --menu "Opportunity actions:" 18 70 8 \
			add "Add opportunity" \
			manage "View, edit, stage, or log opportunity" \
			list "Show sortable opportunity list" \
			back "Back") || return 0

		case "$choice" in
			add) ui_add_opportunity ;;
			manage) ui_manage_opportunity ;;
			list) ui_opportunity_list ;;
			back) return 0 ;;
		esac
	done
}

ui_add_combined_log() {
	local customer_id
	local opportunity_id=""
	local type
	local summary
	local detail

	customer_id=$(ui_select_customer "Log Customer") || return 0

	if dialog --title "Link Opportunity" --yesno "Also link this log to an opportunity?" 8 60; then
		opportunity_id=$(ui_select_opportunity "Log Opportunity") || opportunity_id=""
	fi

	type=$(ui_input "Communication Log" "Communication type:" "email") || return 0
	summary=$(ui_input "Communication Log" "Summary:" "") || return 0
	detail=$(ui_text_input "Communication Log Detail" "Optional detail:" "") || detail=""

	if [[ -z "$type" || -z "$summary" ]]; then
		ui_error "Type and summary are required."
		return 1
	fi

	if [[ -n "$opportunity_id" ]]; then
		log_add --customer "$customer_id" --opportunity "$opportunity_id" --type "$type" --summary "$summary" --detail "$detail" >/dev/null
	else
		log_add --customer "$customer_id" --type "$type" --summary "$summary" --detail "$detail" >/dev/null
	fi
	ui_msg "Added communication log entry."
}

ui_main() {
	local choice

	ui_require_dialog
	ensure_dirs

	while true; do
		choice=$(dialog --stdout --title "${APP_NAME}" --menu "CRM data: ${CRM_DIR}" 18 78 8 \
			customers "Customers" \
			opportunities "Opportunities" \
			log "Add communication log" \
			path "Show data path" \
			help "Show CLI help" \
			exit "Exit") || break

		case "$choice" in
			customers) ui_customer_menu ;;
			opportunities) ui_opportunity_menu ;;
			log) ui_add_combined_log ;;
			path) ui_msg "CRM data directory:\n${CRM_DIR}" ;;
			help)
				local tmp
				tmp=$(mktemp)
				usage >"$tmp"
				ui_textbox "Help" "$tmp"
				rm -f "$tmp"
				;;
			exit) break ;;
		esac
	done

	clear
}

main() {
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--dir)
				require_value "$1" "${2:-}"
				CRM_DIR="$2"
				shift 2
				;;
			--help | -h)
				usage
				exit 0
				;;
			--version)
				printf '%s %s\n' "$APP_NAME" "$VERSION"
				exit 0
				;;
			--)
				shift
				break
				;;
			-*)
				die "Unknown global option: $1"
				;;
			*)
				break
				;;
		esac
	done

	configure_paths

	case "${1:-}" in
		ui) shift; ui_main "$@" ;;
		init) shift; command_init "$@" ;;
		path) shift; command_path "$@" ;;
		customer | customers) shift; customer_command "$@" ;;
		opportunity | opportunities | opp | opps) shift; opportunity_command "$@" ;;
		log) shift; log_command "$@" ;;
		"" | help) usage ;;
		*) die "Unknown command: $1" ;;
	esac
}

main "$@"
